{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://arcifact.io/manifests/certificate.schema.v2.json",
 "title": "Arcifact certificate, schema 2: the evidence behind the numbers is bound",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "subject",
  "release",
  "banks",
  "envelope",
  "stance",
  "fabrication_rate",
  "thresholds",
  "provenance",
  "issued",
  "expires",
  "sha256",
  "evidence_manifest",
  "thresholds_sha256"
 ],
 "properties": {
  "schema_version": {
   "const": "arcifact-certificate/2"
  },
  "subject": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "release": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "banks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "bank",
     "bank_sha256",
     "score",
     "fabrication_rate",
     "n",
     "parse_coverage",
     "commit_coverage",
     "abstention_rate",
     "raw"
    ],
    "properties": {
     "bank": {
      "type": "string",
      "minLength": 1
     },
     "bank_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "fabrication_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "n": {
      "type": "integer",
      "minimum": 1
     },
     "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "parsed answers over questions asked (parse coverage). Kept for continuity with schema 1; the league reports commit_coverage"
     },
     "raw": {
      "type": "object"
     },
     "parse_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "parsed answers over questions asked"
     },
     "commit_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "committed answers over questions asked; the coverage the league reports"
     },
     "abstention_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "entitled abstentions over questions asked"
     },
     "technical_admission_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "answers admitted by the technical layer over questions asked; equals commit_coverage for a raw run"
     },
     "taxonomy": {
      "type": "object",
      "description": "per-response partition: entirely_correct_committed, contaminated_committed, entirely_wrong_committed, entitled_abstention, unparsed_or_error"
     }
    }
   }
  },
  "envelope": {
   "type": "string",
   "minLength": 1,
   "description": "the declared regime in which results hold"
  },
  "stance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "answers",
    "entitled_refusals",
    "errors"
   ],
   "properties": {
    "answers": {
     "type": "integer",
     "minimum": 0
    },
    "entitled_refusals": {
     "type": "integer",
     "minimum": 0
    },
    "errors": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "fabrication_rate": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "thresholds": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "metric",
     "bar",
     "registered_at"
    ],
    "properties": {
     "metric": {
      "type": "string"
     },
     "bar": {
      "type": "number"
     },
     "registered_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  },
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scorer_version",
    "scorer_commit",
    "manifest_root"
   ],
   "properties": {
    "scorer_version": {
     "type": "string"
    },
    "scorer_commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{7,40}$"
    },
    "manifest_root": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "scorer_strict": {
     "type": "boolean"
    },
    "canonicalization": {
     "const": "arcifact-canon/1"
    },
    "evidence_root": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_members": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "issued": {
   "type": "string",
   "format": "date-time"
  },
  "expires": {
   "type": "string",
   "format": "date-time"
  },
  "revocation": {
   "type": "string",
   "format": "uri"
  },
  "signature": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "alg",
    "key_id",
    "public_key",
    "sig"
   ],
   "properties": {
    "alg": {
     "const": "ed25519"
    },
    "public_key": {
     "type": "string"
    },
    "sig": {
     "type": "string"
    },
    "key_id": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "profile": {
   "enum": [
    "draft",
    "report",
    "issued"
   ]
  },
  "bars": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "passed"
   ],
   "properties": {
    "passed": {
     "type": "boolean"
    },
    "details": {
     "type": "string"
    }
   }
  },
  "evidence_manifest": {
   "type": "string",
   "description": "file beside the certificate listing every file behind it with its SHA-256; its root is provenance.evidence_root"
  },
  "thresholds_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$",
   "description": "digest of the thresholds file whose external anchor the verifier checks against the collection time"
  },
  "governed_decomposition": {
   "type": "object",
   "description": "for a governed run: where the governor changed the outcome, item by item (retained, corrected, withheld, answered from the register, unresolved, technical false pass)"
  }
 }
}